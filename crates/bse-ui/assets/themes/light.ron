// Tweakable design tokens for the light theme.
//
// Edit this file with the `hot-reload-tokens` feature on to see the
// changes live in the running app, no recompile needed :
//
//     cargo run --release -p bse-app --features bse-ui/hot-reload-tokens
//
// Keep keys in sync with `bse-ui/src/theme/tokens.rs` — unknown keys
// are silently ignored.
(
    name: "BSE Light",
    colors: (
        brand_yellow:    "#ffd02f",
        brand_blue:      "#4262ff",
        ink:             "#1c1c1e",
        canvas:          "#ffffff",
        surface:         "#f7f8fa",
        hairline:        "#e0e2e8",
        success:         "#00b473",
        warning:         "#e69a00",
        error:           "#e63a46",
    ),
    radii: (
        sm: 4.0,
        md: 8.0,
        lg: 16.0,
        xxxl: 28.0,
        pill: 9999.0,
    ),
    spacing: (
        xs:  4.0,
        sm:  8.0,
        md: 12.0,
        lg: 16.0,
        xl: 24.0,
    ),
)
