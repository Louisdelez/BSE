# Reference environment for self-hosted BSE.
# Copy to `.env` and fill the values, then `docker compose up -d`.

# A long, random secret used to sign JWTs (32+ bytes recommended).
# Generate with : openssl rand -hex 48
BSE_JWT_SECRET=replace-me-with-at-least-48-hex-bytes

# Comma-separated list of origins allowed in CORS. Leave empty if you
# only use the desktop client.
# Example : BSE_ALLOWED_ORIGINS=https://bse.example.com,https://staging.example.com
BSE_ALLOWED_ORIGINS=
